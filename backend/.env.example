# ===== Agent Job Coach 环境变量模板 =====
# 复制为 backend/.env 后填入真实值；.env 已在 .gitignore 中，绝不提交

# 应用
# 安全提示：本系统无鉴权。HOST=0.0.0.0 时局域网内任何机器均可访问全部接口
# （含简历等隐私数据），仅限本机/可信网络使用，切勿暴露公网；仅本机使用可改 HOST=127.0.0.1
APP_NAME=Agent Job Coach
DEBUG=true
HOST=0.0.0.0
PORT=9902
MAX_UPLOAD_MB=10

# 智谱 GLM（OpenAI 兼容）：https://open.bigmodel.cn 申请
# 对话模型带推理链，LLM_MAX_TOKENS 建议 >= 4096
LLM_API_KEY=your-zhipu-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.1
LLM_MAX_TOKENS=4096

# Embedding（与对话共用同一 Key 即可）
EMBEDDING_API_KEY=your-zhipu-api-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-2

# MySQL（需提前建库：CREATE DATABASE agent_job_coach DEFAULT CHARSET utf8mb4;）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=agent_job_coach

# Redis（会话历史 / 面试事件流，7 天 TTL）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 知识库（源文件目录 / Chroma 持久化目录）
KB_DATA_DIR=../data
KB_VECTOR_DIR=./vector_db
KB_TOP_K=4
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50

# Agent 参数
AGENT_MAX_STEPS=6
INTERVIEW_MAX_ROUNDS=5
